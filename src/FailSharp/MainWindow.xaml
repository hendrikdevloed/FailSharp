<Window x:Class="FailSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FailSharp — Engine Failure Setup" Height="360" Width="420"
        ResizeMode="CanMinimize" SizeToContent="Height">
    <StackPanel Margin="16">
        <TextBlock Text="FailSharp" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="Random engine failure simulator" Foreground="Gray" Margin="0,0,0,12" />

        <CheckBox x:Name="EnabledCheckBox" Content="Enable random engine failures" Margin="0,0,0,12"
                  Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

        <TextBlock x:Name="ProbabilityLabel" Text="Chance per check: 5%" />
        <Slider x:Name="ProbabilitySlider" Minimum="0" Maximum="100" TickFrequency="5"
                ValueChanged="OnProbabilityChanged" Margin="0,0,0,12" />

        <TextBlock x:Name="IntervalLabel" Text="Check interval: 5 min" />
        <Slider x:Name="IntervalSlider" Minimum="1" Maximum="60" TickFrequency="1"
                ValueChanged="OnIntervalChanged" Margin="0,0,0,12" />

        <TextBlock Text="Eligible engines:" Margin="0,0,0,4" />
        <StackPanel x:Name="EnginesPanel" Orientation="Horizontal" Margin="0,0,0,12" />

        <Button x:Name="RepairButton" Content="Repair all engines" Padding="8,4"
                HorizontalAlignment="Left" Click="OnRepairClicked" Margin="0,0,0,12" />

        <TextBlock x:Name="StatusText" Text="Connecting..." Foreground="Gray" />
    </StackPanel>
</Window>

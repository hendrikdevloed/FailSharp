<Window x:Class="FailSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FailSharp — Engine Failure Setup" Width="380" MinWidth="340"
        ResizeMode="CanResize" SizeToContent="Height">
    <Window.Resources>
        <Style x:Key="InvisibleRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FF2B3440" Stroke="White" StrokeThickness="1.5" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource InvisibleRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource RangeThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="EnabledCheckBox" Content="Enabled" VerticalAlignment="Center"
                      Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SimConnectStatusText" Text="SimConnect ✕" FontSize="11" Foreground="Gray"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="MenuStatusText" Text="Menu ✕" FontSize="11" Foreground="Gray"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="ProbabilityLabel" Text="Chance: 5%" />
                <Slider x:Name="ProbabilitySlider" Minimum="0" Maximum="100" TickFrequency="5"
                        ValueChanged="OnProbabilityChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="IntervalLabel" Text="Every: 5 min" />
                <Slider x:Name="IntervalSlider" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="OnIntervalChanged" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="SpeedRangeLabel" Text="Active between 60-150 kts" Margin="0,0,0,2" />
        <Grid Grid.Row="3" Height="24" Margin="0,0,0,10">
            <Grid x:Name="SpeedRangeFillGrid" VerticalAlignment="Center" Height="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BelowMinColumn" Width="60*" />
                    <ColumnDefinition x:Name="InRangeColumn" Width="90*" />
                    <ColumnDefinition x:Name="AboveMaxColumn" Width="100*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#33000000" CornerRadius="3" />
                <Border Grid.Column="1" Background="#FF3B82C4" CornerRadius="3" />
                <Border Grid.Column="2" Background="#33000000" CornerRadius="3" />
            </Grid>
            <Slider x:Name="MinSpeedSlider" Minimum="0" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True"
                    Style="{StaticResource RangeSliderStyle}" ValueChanged="OnSpeedRangeChanged" />
            <Slider x:Name="MaxSpeedSlider" Minimum="0" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True"
                    Style="{StaticResource RangeSliderStyle}" ValueChanged="OnSpeedRangeChanged" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="RepairButton" Content="Repair all engines" Padding="8,4" VerticalAlignment="Center"
                    Click="OnRepairClicked" Margin="0,0,12,0" />
            <StackPanel x:Name="EnginesPanel" Orientation="Horizontal" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
